# Elige UNA opción y borra el # del principio de sus líneas.
# Sin archivo .env, el taller funciona en modo demo.

# Opción 1 · GRATIS, sin clave ni cuenta (modelo simulado)
MODELO=demo

# Opción 2 · GRATIS, respuestas reales con Google Gemini
# Clave gratuita (sin tarjeta) en https://aistudio.google.com -> Get API key
# Comprueba en AI Studio el nombre exacto de un modelo gratuito "flash".
# MODELO=gemini/gemini-3.5-flash-lite
# GEMINI_API_KEY=pon-aqui-tu-clave

# Opción 3 · DE PAGO (OpenAI)
# MODELO=gpt-4o-mini
# OPENAI_API_KEY=pon-aqui-tu-clave
